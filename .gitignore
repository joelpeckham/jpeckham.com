# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated from the resume submodule at build time
/public/Joel_Peckham_Resume.pdf

# Oracle MySQL Reference Manual (local only; not redistributable)
/sources/mysql-refman-*/

# Laravel docs (MIT; local study copy, not republished)
/sources/laravel-docs-*/

# DJ daemon runtime state (seed.json is committed)
/dj-daemon/data/state.json
/dj-daemon/data/state.json.bak
/dj-daemon/data/state.json.tmp
